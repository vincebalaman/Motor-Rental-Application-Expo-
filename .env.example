# Copy to .env.local. These are public client settings, never server secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional fixed recovery callback for a development build or deployed web app.
# Leave unset in Expo Go: the app generates the return URL for the current Metro host.
# EXPO_PUBLIC_RECOVERY_REDIRECT_URL=motorrentalexpo://auth/reset-password

# Enable only AFTER deploying payment SQL/functions and configuring provider secrets.
# Test mode is controlled by backend PAYMENTS_LIVE_MODE, not this UI flag.
EXPO_PUBLIC_ONLINE_PAYMENTS_ENABLED=false

# Educational mock checkout is the default and needs no payment migration/provider.
# Set to provider only when configuring the real PayMongo test/live integration.
EXPO_PUBLIC_PAYMENT_MODE=demo
