{
  "expo": {
    "name": "Motor-Rental-Expo",
    "slug": "Motor-Rental-Expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/motorrent-app-icon.png",
    "scheme": "motorrentalexpo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/motorrent-app-icon.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/images/motorrent-app-icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/motorrent-logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2efe6",
          "image": "./assets/images/motorrent-logo.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile or a motor listing.",
          "cameraPermission": "Take a photo for your profile or a motor listing.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
